{
  "name": "personal-website",
  "private": true,
  "version": "2.6.0",
  "packageManager": "pnpm@10.17.1",
  "type": "module",
  "homepage": "https://www.colemanlai.com",
  "scripts": {
    "dev": "react-router dev",
    "optimize-images": "node scripts/optimize-images.mjs",
    "prepare": "husky",
    "prebuild": "node scripts/sync-package-version.mjs",
    "sync-version": "node scripts/sync-package-version.mjs",
    "build": "node scripts/optimize-images.mjs && node scripts/build-hook.js && pnpm run typecheck && react-router build && node scripts/finalize-build.mjs && node scripts/generate-rss.js",
    "typecheck": "react-router typegen && tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel",
    "sync-projects": "node scripts/project-auto-config.js",
    "watch-projects": "node scripts/project-watcher.js",
    "dev:watch": "concurrently \"pnpm run dev\" \"pnpm run watch-projects\""
  },
  "dependencies": {
    "@octokit/rest": "^20.0.2",
    "@vercel/analytics": "^1.4.1",
    "@vercel/speed-insights": "^1.1.0",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "lenis": "^1.3.17",
    "marked": "^14.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.4.0",
    "react-markdown": "^9.0.3",
    "react-router": "^7.18.4",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^7.18.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "chokidar": "^4.0.3",
    "concurrently": "^9.2.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lighthouse": "^13.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vercel": "^50.25.4",
    "vite": "^8.3.4",
    "vite-plugin-sitemap": "^0.7.1"
  }
}
